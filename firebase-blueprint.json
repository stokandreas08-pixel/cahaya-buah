{
  "entities": {
    "bungkaran_records": {
      "title": "Catatan Bungkaran Buah",
      "description": "Data pembongkaran mobil, kode bungkaran buah, upah, dan nama-nama pembungkar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "packagingCode": { "type": "string" },
        "packageCount": { "type": "number" },
        "wagePerCar": { "type": "number" },
        "wageMethod": { "type": "string" },
        "ratePerPackage": { "type": "number" },
        "workerNames": { "type": "array", "items": { "type": "string" } },
        "wagePerWorker": { "type": "number" },
        "workerTeam": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["lunas", "belum_dibayar"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["packagingCode", "packageCount", "wagePerCar", "workerNames", "wagePerWorker", "paymentStatus"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /bungkaran_records/{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
